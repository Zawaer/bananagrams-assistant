# Dockerfile for the frontend: a static export of the Next.js app, served by
# Caddy, which also proxies the two backends under /api so that the browser
# talks to a single origin. Build from the repository root:
#   docker build -f Dockerfile.frontend .

FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable
COPY frontend/package.json frontend/yarn.lock frontend/.yarnrc.yml ./
RUN yarn install --immutable
COPY frontend/ ./
# Read at build time and inlined into the bundle. Relative paths keep every
# request on the page's own origin, which is what lets this work behind HTTPS
# (and so lets the in-page camera work) without separate backend addresses.
ARG NEXT_PUBLIC_SOLVER_SERVER_URL=/api/solver
ARG NEXT_PUBLIC_DETECTION_SERVER_URL=/api/detect
ENV NEXT_PUBLIC_SOLVER_SERVER_URL=$NEXT_PUBLIC_SOLVER_SERVER_URL \
    NEXT_PUBLIC_DETECTION_SERVER_URL=$NEXT_PUBLIC_DETECTION_SERVER_URL
RUN yarn build

FROM caddy:2-alpine
COPY frontend/Caddyfile /etc/caddy/Caddyfile
COPY --from=builder /app/out /srv
EXPOSE 80
