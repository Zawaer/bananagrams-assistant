# Keep the build context small. Without this it is ~2.5 GB, almost all of it
# dependencies and training data that no image needs.
.git
.gitignore
.DS_Store
**/.DS_Store

# dependencies and build output
**/node_modules
**/.next
**/.venv
**/__pycache__
**/*.pyc

# model weights are mounted or downloaded at run time, never baked in
image-segmentation/

# docs and README media
docs/
*.md
